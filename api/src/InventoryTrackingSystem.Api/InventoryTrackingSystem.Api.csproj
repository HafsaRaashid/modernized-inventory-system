<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Local-dev secret store (dotnet user-secrets) — see bootstrap-plan.md
         "Local Development Setup" for how the SQL Server connection string
         is supplied without ever being committed. -->
    <UserSecretsId>inventorytrackingsystem-api-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryTrackingSystem.Infrastructure\InventoryTrackingSystem.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BL-003: unlike most ASP.NET Core authentication/authorization types,
         the JWT bearer handler is not part of the Microsoft.AspNetCore.App
         shared framework — it depends on the Microsoft.IdentityModel/
         System.IdentityModel.Tokens.Jwt libraries, which ship only as NuGet
         packages, so it must be referenced explicitly here. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <!-- EF Core design-time tooling (dotnet-ef) requires this package on the
         startup project itself — the Infrastructure project's reference has
         PrivateAssets=all and does not flow transitively. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
