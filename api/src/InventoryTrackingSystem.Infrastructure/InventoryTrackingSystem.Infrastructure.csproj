<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- SQ-002 (keep SQL Server) + SQ-014 (EF Core as the ORM). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- JWT issuance (JwtTokenService) — explicit reference rather than relying
         on the transitive copy pulled in by Microsoft.Data.SqlClient's
         Azure.Identity chain (design.md Key Decisions). Pinned to 6.35.0 to
         match the Microsoft.IdentityModel.* version already resolved via that
         transitive graph. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.35.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryTrackingSystem.Domain\InventoryTrackingSystem.Domain.csproj" />
  </ItemGroup>

</Project>
